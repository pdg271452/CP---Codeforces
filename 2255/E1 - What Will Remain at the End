#include <iostream>
#include <vector>
#include <algorithm>
#include <cstdint>
 
using namespace std;
 
// Represents a transformation tag over a sequence of operations
struct Tag {
    int8_t a[3];
    int s[3];
    int p[3];
    int l[3];
    int m[3];
};
 
Tag make_atomic_tag(int op_type, int extra_x = 0) {
    Tag tag;
    for (int v = -1; v <= 1; v++) {
        int idx = v + 1;
        int val = 0;
        if (op_type == 1) val = extra_x;
        else if (op_type == 2) val = -v;
        else if (op_type == 3) val = max(v, 0);
        else if (op_type == 4) val = v;
        tag.a[idx] = (int8_t)val;
        tag.s[idx] = val;
        tag.p[idx] = val;
        tag.l[idx] = val;
        tag.m[idx] = val;
    }
    return tag;
}
 
Tag combine_tags(const Tag& t1, const Tag& t2) {
    Tag res;
    for (int v = -1; v <= 1; v++) {
        int i = v + 1;
        int v1 = t1.a[i];
        int j = v1 + 1;
        res.a[i] = t2.a[j];
        res.s[i] = t1.s[i] + t2.s[j];
        res.p[i] = max(t1.p[i], t1.s[i] + t2.p[j]);
        res.l[i] = max(t2.l[j], t1.l[i] + t2.s[j]);
        res.m[i] = max({t1.m[i], t2.m[j], t1.l[i] + t2.p[j]});
    }
    return res;
}
 
struct Leaf {
    int8_t a;
    int S, P, L, M;
};
 
struct SegTree {
    int n;
    vector<Leaf> leaves;
    vector<Tag> tags;
    vector<bool> has_tag;
    uint64_t lastans = 0;
    Tag tag_untouched;
 
    SegTree(int n, const vector<int>& arr) : n(n) {
        leaves.resize(n);
        for (int i = 0; i < n; i++) {
            int v = arr[i];
            leaves[i] = {(int8_t)v, v, v, v, v};
        }
        tags.resize(4 * n);
        has_tag.assign(4 * n, false);
        tag_untouched = make_atomic_tag(4);
    }
 
    void apply_tag_to_leaf(Leaf& leaf, const Tag& tag) {
        int idx = leaf.a + 1;
        int v_next = tag.a[idx];
        int s = tag.s[idx], p = tag.p[idx], l = tag.l[idx], m = tag.m[idx];
 
        int S_new = leaf.S + s;
        int P_new = max(leaf.P, leaf.S + p);
        int L_new = max(l, leaf.L + s);
        int M_new = max({leaf.M, m, leaf.L + p});
 
        leaf.a = (int8_t)v_next;
        leaf.S = S_new;
        leaf.P = P_new;
        leaf.L = L_new;
        leaf.M = M_new;
    }
 
    void apply_tag_to_node(int node, const Tag& tag) {
        if (!has_tag[node]) {
            tags[node] = tag;
            has_tag[node] = true;
        } else {
            tags[node] = combine_tags(tags[node], tag);
        }
    }
 
    void push(int node, int l, int r) {
        if (has_tag[node]) {
            if (l == r) {
                apply_tag_to_leaf(leaves[l], tags[node]);
            } else {
                apply_tag_to_node(2 * node, tags[node]);
                apply_tag_to_node(2 * node + 1, tags[node]);
            }
            has_tag[node] = false;
        }
    }
 
    void update_range(int node, int l, int r, int ql, int qr, const Tag& tag) {
        push(node, l, r);
        if (r < ql || l > qr) return;
        if (ql <= l && r <= qr) {
            apply_tag_to_node(node, tag);
            return;
        }
        int mid = (l + r) / 2;
        update_range(2 * node, l, mid, ql, qr, tag);
        update_range(2 * node + 1, mid + 1, r, ql, qr, tag);
    }
 
    int query_point(int node, int l, int r, int idx) {
        push(node, l, r);
        if (l == r) {
            return leaves[l].M;
        }
        int mid = (l + r) / 2;
        if (idx <= mid) return query_point(2 * node, l, mid, idx);
        else return query_point(2 * node + 1, mid + 1, r, idx);
    }
 
    int get_d(uint64_t y) {
        return ((y ^ lastans) % n) + 1;
    }
 
    void op1(uint64_t u, uint64_t v, int x) {
        int du = get_d(u), dv = get_d(v);
        int l = min(du, dv) - 1, r = max(du, dv) - 1;
        Tag tag_touched = make_atomic_tag(1, x);
        if (l > 0) update_range(1, 0, n - 1, 0, l - 1, tag_untouched);
        update_range(1, 0, n - 1, l, r, tag_touched);
        if (r + 1 < n) update_range(1, 0, n - 1, r + 1, n - 1, tag_untouched);
    }
 
    void op2(uint64_t u, uint64_t v) {
        int du = get_d(u), dv = get_d(v);
        int l = min(du, dv) - 1, r = max(du, dv) - 1;
        Tag tag_touched = make_atomic_tag(2);
        if (l > 0) update_range(1, 0, n - 1, 0, l - 1, tag_untouched);
        update_range(1, 0, n - 1, l, r, tag_touched);
        if (r + 1 < n) update_range(1, 0, n - 1, r + 1, n - 1, tag_untouched);
    }
 
    void op3(uint64_t u, uint64_t v) {
        int du = get_d(u), dv = get_d(v);
        int l = min(du, dv) - 1, r = max(du, dv) - 1;
        Tag tag_touched = make_atomic_tag(3);
        if (l > 0) update_range(1, 0, n - 1, 0, l - 1, tag_untouched);
        update_range(1, 0, n - 1, l, r, tag_touched);
        if (r + 1 < n) update_range(1, 0, n - 1, r + 1, n - 1, tag_untouched);
    }
 
    int op4(uint64_t u) {
        int p = get_d(u) - 1;
        int ans = query_point(1, 0, n - 1, p);
        lastans = (uint64_t)ans;
        update_range(1, 0, n - 1, 0, n - 1, tag_untouched);
        return ans;
    }
};
 
void solve() {
    int n, q;
    if (!(cin >> n >> q)) return;
 
    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
 
    SegTree st(n, a);
 
    for (int i = 0; i < q; i++) {
        int type;
        cin >> type;
        if (type == 1) {
            uint64_t u, v;
            int x;
            cin >> u >> v >> x;
            st.op1(u, v, x);
        } else if (type == 2) {
            uint64_t u, v;
            cin >> u >> v;
            st.op2(u, v);
        } else if (type == 3) {
            uint64_t u, v;
            cin >> u >> v;
            st.op3(u, v);
        } else if (type == 4) {
            uint64_t u;
            cin >> u;
            cout << st.op4(u) << "
";
        }
    }
}
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
 
    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}