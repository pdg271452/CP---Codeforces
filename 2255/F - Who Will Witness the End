#include <bits/stdc++.h>
using namespace std;
using ll = long long;
 
const int md = 998244353, mxn = 200005;
ll fc[mxn];
 
ll pw(ll b, ll e) {
    ll r = 1;
    b %= md;
    while (e) {
        if (e & 1) r = r * b % md;
        b = b * b % md;
        e >>= 1;
    }
    return r;
}
 
void ntt(vector<ll> &a, bool iv) {
    int n = a.size();
    for (int i = 1, j = 0; i < n; i++) {
        int b = n >> 1;
        for (; j & b; b >>= 1) j ^= b;
        j ^= b;
        if (i < j) swap(a[i], a[j]);
    }
    for (int ln = 1; ln < n; ln <<= 1) {
        ll w = pw(3, (md - 1) / (2 * ln));
        if (iv) w = pw(w, md - 2);
        for (int i = 0; i < n; i += 2 * ln) {
            ll cw = 1;
            for (int j = 0; j < ln; j++) {
                ll u = a[i + j], v = a[i + j + ln] * cw % md;
                a[i + j] = (u + v) % md;
                a[i + j + ln] = (u - v + md) % md;
                cw = cw * w % md;
            }
        }
    }
    if (iv) {
        ll ni = pw(n, md - 2);
        for (int i = 0; i < n; i++) a[i] = a[i] * ni % md;
    }
}
 
vector<ll> mul(vector<ll> a, vector<ll> b) {
    int rs = a.size() + b.size() - 1;
    if ((ll)a.size() * b.size() <= 1024) {
        vector<ll> r(rs, 0);
        for (size_t i = 0; i < a.size(); i++)
            if (a[i])
                for (size_t j = 0; j < b.size(); j++) r[i + j] = (r[i + j] + a[i] * b[j]) % md;
        return r;
    }
    int sz = 1;
    while (sz < rs) sz <<= 1;
    a.resize(sz), b.resize(sz);
    ntt(a, 0), ntt(b, 0);
    for (int i = 0; i < sz; i++) a[i] = a[i] * b[i] % md;
    ntt(a, 1);
    a.resize(rs);
    return a;
}
 
vector<ll> prd(int l, int r, const vector<ll> &a) {
    if (l == r) return {1, a[l]};
    int m = (l + r) >> 1;
    return mul(prd(l, m, a), prd(m + 1, r, a));
}
 
void sol() {
    int n;
    scanf("%d", &n);
    vector<ll> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]), a[i] %= md;
    vector<ll> e = prd(0, n - 1, a), pre(n - 1);
    for (int s = 0; s <= n - 2; s++) {
        ll h = fc[s] * fc[n - 2 - s] % md;
        pre[s] = ((s ? pre[s - 1] : 0) + h) % md;
    }
    auto rng = [&](int l, int r) -> ll {
        if (l > r) return 0;
        return (pre[r] - (l ? pre[l - 1] : 0) % md + md) % md;
    };
    ll ans = 2 * fc[n - 1] % md * e[n] % md;
    for (int i = 0; i < n; i++) {
        ll g = e[i] * e[n - i] % md;
        if (!g) continue;
        ll c = g * (ll)(n - i) % md;
        int d = n - 2 * i - 1;
        if (d > 0) ans = (ans - c * rng(i, n - 2 - i)) % md;
        else if (d < 0) ans = (ans + c * rng(n - i - 1, i - 1)) % md;
    }
    printf("%lld
", (ans % md + md) % md);
}
 
int main() {
    fc[0] = 1;
    for (int i = 1; i < mxn; i++) fc[i] = fc[i - 1] * i % md;
    int t;
    scanf("%d", &t);
    while (t--) sol();
    return 0;
}