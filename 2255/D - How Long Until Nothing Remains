#include<bits/stdc++.h>
using namespace std;
const int N=1<<18;
int t,n;
int a[N];
void solve(){
	scanf("%d",&n);
	for(int i=1;i<=n;i++) scanf("%d",&a[i]);
	sort(a+1,a+n+1);
	for(int i=n;i<=n+30;i++){
		priority_queue<int> q;
		for(int j=1;j<=n;j++) q.push(a[j]);
		for(int j=i-1;j>=0;j--){
			if(q.empty()) break;
			int u=q.top();q.pop();
			if(j>31) continue;
			if(u-(1ll<<j)>0) q.push(u-(1ll<<j));
		}
		if(q.empty()) return printf("%d
",i),void();
	}
}
int main(){
	scanf("%d",&t);
	while(t--) solve();
	return 0;
}